 application "College Workshop and Certification System"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form certification_details
		{
			displayname = "Certification Details"
			success message = "Certification Details Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Certificate_ID
			(
    			type = autonumber
				displayname = "Certificate ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have student
			(
				type = list	
				displayname = "Student"
				values  = student_details.ID
    			displayformat = [student_name.first_name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 60px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have workshop
			(
				type = list	
				displayname = "Workshop"
				values  = workshop_details.ID
    			displayformat = [workshop_title]
				height = 60px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have certificate_number
			(
    			type = text
				displayname = "Certificate Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have issue_date
			(
    			type = date
				displayname = "Issue Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have certificate_status
			(
				type = picklist
				displayname = "Certificate Status"
				values = {"Revoked","Issued","Pending"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Email_Sent
			(
				type = picklist
				displayname = "Email Sent"
				maxchar = 100
				values = {"YES","NO"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			certificate_file
			(
    			type = text
				displayname = "Certificate File"
	 			row = 1
	 			column = 1   
				width = medium
			)
			remarks
			(
    			type = textarea
				displayname = "Remarks"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
