			{
				type =  form
				form = workshop_registration

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Set registration status to Pending when a new record is created
										if(input.ID == null)
										{
											input.registration_status = "Pending";
										}
						)
					}
				}

			}
			validate_registration_deadline as "Validate Registration Deadline"
			{
				type =  form
				form = workshop_registration

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// // Fetch the workshop details using the multi_select_lookup field
										// workshopRecords = workshop_details[ID == input.workshop];
										// // Check if workshop record exists
										// if(workshopRecords.count() > 0)
										// {
										// 	// Get the registration deadline from the workshop
										// 	registrationDeadline = workshopRecords.registration_deadline;
										// 	// Get the registration date from input
										// 	registrationDate = input.registration_date;
										// 	// Compare registration date with deadline
										// 	if(registrationDate > registrationDeadline)
										// 	{
										// 		// Display error message before canceling submission
										// 		alert "Registration date cannot exceed the workshop registration deadline. Please enter a valid date.";
										// 		cancel submit;
										// 	}
										// }
										// Check whether the required fields are filled
										if(input.workshop == null)
										{
											alert "Please select a workshop.";
											cancel submit;
										}
										if(input.registration_date == null)
										{
											alert "Please enter the registration date.";
											cancel submit;
										}
										// Fetch the selected workshop record
										workshopRecord = workshop_details[ID == input.workshop];
										if(workshopRecord == null)
										{
											alert "Selected workshop details could not be found.";
											cancel submit;
										}
										// Check whether workshop date is available
										if(workshopRecord.workshop_date == null)
										{
											alert "Workshop date is not available. Please contact the administrator.";
											cancel submit;
										}
										// Registration must always be before the workshop date
										if(input.registration_date >= workshopRecord.workshop_date)
										{
											alert "Registration failed! The workshop date has already arrived or passed.";
											cancel submit;
										}
										// If registration deadline exists, validate it
										if(workshopRecord.registration_deadline != null)
										{
											if(input.registration_date > workshopRecord.registration_deadline)
											{
												alert "Registration failed! The registration deadline has passed.";
												cancel submit;
											}
										}
						)
					}
				}

			}
			send_approval_email as "Send Approval Email"
			{
				type =  form
				form = workshop_registration

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the student record using the multi_select_lookup field
										studentRecord = student_details[ID == input.student.get(0)];
										// Check if student email is valid
										if(studentRecord.email_address.isNull())
										{
											info "Student email address is missing";
										}
										else
										{
											// Send approval email to the student
											sendmail
											[
												from :zoho.loginuserid
												to :studentRecord.email_address
												subject :"Workshop Registration Approved"
												message :"Dear " + studentRecord.student_name.first_name + ",\n\nYour registration for the workshop has been approved.\n\nBest regards,\nCollege Workshop Certification System"
											]
										}
						)
					}
				}

			}
			Send_Certificate_Email_Wh as "Send Certificate Email When Issued"
			{
				type =  form
				form = certification_details

				record event = on add or edit

				on success
				{
					actions  (certificate_status == "Issued" && Email_Sent == "NO")
					{
						custom deluge script
						(
											studentRecord = student_details[ID == input.student];
										if(studentRecord.ID != null && studentRecord.email_address != null)
										{
											sendmail
											[
												from :zoho.adminuserid
												to :studentRecord.email_address
												subject :"Your Workshop Certificate"
												message :"Congratulations! Your workshop certificate is attached."
												Attachments :template:Student_Workshop_Certificate as PDF
											]
										}
						)
					update certification_details[ID == input.ID]
					[
						Email_Sent = "YES"
					]
					}
				}

			}
			Validate_Certificate_Elig as "Validate Certificate Eligibility"
			{
				type =  form
				form = certification_details

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.certificate_status == "Issued")
										{
											studentID = input.student;
											workshopID = input.workshop;
											totalSessions = workshop_attendance[student == studentID && workshop == workshopID].count();
											presentSessions = workshop_attendance[student == studentID && workshop == workshopID && attendance_status == "Present"].count();
											workshopRecord = workshop_details[ID == workshopID];
											if(totalSessions == 0)
											{
												alert "Certificate cannot be issued because no attendance records exist.";
												cancel submit;
											}
											else
											{
												attendancePercentage = (presentSessions * 100.0) / totalSessions;
												if(attendancePercentage < workshopRecord.minimum_attendance_percentage)
												{
													alert "Certificate cannot be issued because the minimum attendance requirement is not met.";
													cancel submit;
												}
											}
										}
						)
					}
				}

			}
		}

		schedule
		{
			Workshop_Reminder_Email as "Workshop Reminder Email"
			{
				type =  schedule
				start = "2026-11-05 11:00:00"
				frequency = daily
				time zone = "America/Los_Angeles"
				on start
				{
					actions 
					{
					on load
					(
						// Calculate tomorrow's date
										tomorrow = zoho.currentdate.addDay(1);
										// Find workshops scheduled for tomorrow
										for each  workshopRecord in workshop_details[workshop_date == tomorrow]
										{
											// Find registrations for the selected workshop
											for each  registrationRecord in workshop_registration[workshop == workshopRecord.ID]
											{
												// Retrieve student details
												studentRecord = student_details[ID == registrationRecord.student];
												// Check whether the student's email is available
												if(studentRecord.ID != null && studentRecord.email_address != null)
												{
													sendmail
													[
														from :zoho.adminuserid
														to :studentRecord.email_address
														subject :"Reminder: Your Workshop Is Tomorrow!"
														message :"Dear Student,<br><br>This is a reminder that you have registered for the following workshop:<br><br><b>Workshop Name:</b> " + workshopRecord.workshop_title + "<br><b>Workshop Date:</b> " + workshopRecord.workshop_date + "<br><br>Please attend the workshop on time.<br><br>Thank you,<br>College Workshop and Certification Management System"
													]
												}
											}
										}
					)
					}
				}
			}
		}

		approval
		{
			registration_workflow as "registration workflow"
			{
				type =  approval
				form = workshop_registration
				display fields = [Registration_ID,student,workshop,registration_date,registration_status]
				on start
				{
				}
				on level 1
				{
					on approve 
					{
						actions 
						{
							sendmail
							(
								from : zoho.loginuserid
								to : approver.submitter
								subject : "Approval Request"
								message : "Your request has been approved."
							)
						}
					}
					on reject
					{

						actions 
						{
							sendmail
							(
								from : zoho.loginuserid
								to : approver.submitter
								subject : "Approval Request"
								message : "Your request has been rejected."
							)
						}
					}
				}
			}
		}



	}
