				condition = (year_of_study == "First Year")
				fields = [year_of_study]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (year_of_study == "Second Year")
				fields = [year_of_study]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (year_of_study == "Third Year")
				fields = [year_of_study]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
