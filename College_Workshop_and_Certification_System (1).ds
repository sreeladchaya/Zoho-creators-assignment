	 			display field = attendance_status
	 		)
		}
		list certification_details_Report
		{
			displayName = "All Certification Details"
			print template = Student_Workshop_Certificate
			show all rows from certification_details    
			(
				student as "Student"
				workshop as "Workshop"
				certificate_number as "Certificate Number"
				issue_date as "Issue Date"
				certificate_status as "Certificate Status"
				certificate_file as "Certificate File"
				remarks as "Remarks"
				Email_Sent as "Email Sent"
			)
			sort by
			(
				issue_date descending
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (certificate_status == "Issued")
				fields = [certificate_status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (certificate_status == "Pending")
				fields = [certificate_status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (certificate_status == "Revoked")
				fields = [certificate_status]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban certification_details_by_certificate_status
		{
			displayName = "Certificate Statuses"
