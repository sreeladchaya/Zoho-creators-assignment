    			type = text
				displayname = "Venue"
	 			row = 1
	 			column = 1   
				width = medium
			)
			registration_deadline
			(
    			type = date
				displayname = "Registration Deadline"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			maximum_participants
			(
				type = number
				displayname = "Maximum Participants"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			registration_fee
			(
				displayname = "Registration Fee"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have certificate_available
			(
    			type = checkbox
				displayname = "Certificate Available"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have certificate_type
			(
				type = picklist
				displayname = "Certificate Type"
				values = {"Completion Certificate","Participation Certificate","No Certificate"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			minimum_attendance_percentage
			(
				type = number
				displayname = "Minimum Attendance Percentage"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			trainer
			(
				type = list	
				displayname = "Trainer"
				values  = trainer_details.ID
    			displayformat = [trainer_name.first_name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form workshop_registration
		{
			displayname = "Workshop Registration"
			success message = "Workshop Registration Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Registration_ID
			(
    			type = autonumber
				displayname = "Registration ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have student
			(
				type = list	
				displayname = "Student"
				values  = student_details.ID
    			displayformat = [student_name.first_name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 60px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have workshop
			(
				type = list	
				displayname = "Workshop"
				values  = workshop_details.ID
    			displayformat = [workshop_title]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 60px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have registration_date
			(
    			type = date
				displayname = "Registration Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have registration_status
			(
				type = picklist
				displayname = "Registration Status"
				values = {"Approved","Rejected","Cancelled","Pending"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Registration Initiated","Pending Approval","Registration Cancelled","Approved","Rejected","Completed","Cancelled"}
			}
		}
	}
	reports
	{
		list workshop_registration_Report
		{
			displayName = "All Workshop Registrations"
			show all rows from workshop_registration    
			(
				student as "Student"
				workshop as "Workshop"
				registration_date as "Registration Date"
				registration_status as "Registration Status"
			)
			filters
			(
				"Pending Registrations."  :  registration_status == "Pending"
				"Approved Registrations"  :  registration_status == "Approved"
				"Rejected Registrations"  :  registration_status == "Rejected"
			)
			sort by
			(
				registration_date descending
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (registration_status == "Approved")
				fields = [registration_status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (registration_status == "Cancelled")
				fields = [registration_status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (registration_status == "Pending")
				fields = [registration_status]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban workshop_registration_by_registration_status
		{
			displayName = "Registration Statuses"
			show all rows from workshop_registration    
			(
				student as "Student"
				workshop as "Workshop"
				registration_date as "Registration Date"
				registration_status as "Registration Status"
			)
			options
			(
	 			display field = registration_status
	 		)
		}
		list workshop_attendance_Report
		{
			displayName = "All Workshop Attendances"
			show all rows from workshop_attendance    
			(
				student as "Student"
				workshop as "Workshop"
				attendance_date as "Attendance Date"
				attendance_status as "Attendance Status"
				completion_status as "Completion Status"
				remarks as "Remarks"
			)
			sort by
			(
				attendance_date descending
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (attendance_status == "Absent")
				fields = [attendance_status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (attendance_status == "Late")
				fields = [attendance_status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (attendance_status == "Present")
				fields = [attendance_status]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban workshop_attendance_by_attendance_status
		{
			displayName = "Attendance Statuses"
